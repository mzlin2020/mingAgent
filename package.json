{
  "name": "xiaoming",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "小明 · 通用私人 Agent",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "node scripts/assert-toolchain.mjs && node scripts/install-hooks.mjs",
    "toolchain": "node scripts/assert-toolchain.mjs",
    "build": "tsc -b",
    "typecheck": "node scripts/typecheck-workspace.mjs",
    "typecheck:clean": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:kernel-coverage": "vitest run --coverage --config vitest.kernel.config.ts",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "verify": "node scripts/assert-toolchain.mjs && node scripts/check-workflows.mjs && node scripts/check-tsconfig-paths.mjs && node scripts/check-file-size.mjs && node scripts/check-local-supply-chain.mjs && node scripts/check-determinism-boundary.mjs && tsc -b && node scripts/generate-seam-map.mjs --check && tsc -p tsconfig.tests.json && tsc -p apps/desktop/tsconfig.main.json && tsc -p apps/desktop/tsconfig.renderer.json && eslint . && vitest run && vitest run --coverage --config vitest.kernel.config.ts && node scripts/smoke-headless.mjs && node scripts/smoke-write-lease-recovery.mjs && pnpm depcruise && pnpm size",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "smoke": "node scripts/smoke.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:paths": "node scripts/check-tsconfig-paths.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:determinism": "node scripts/check-determinism-boundary.mjs",
    "dump-config": "tsc -b packages/compose && node scripts/dump-profile.mjs --dump-config",
    "generate:seams": "tsc -b packages/compose && node scripts/generate-seam-map.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "rimraf": "^6.1.3",
    "size-limit": "^13.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "size-limit": [
    {
      "name": "@xm/contracts (自身，不含 zod)",
      "path": "packages/contracts/dist/index.js",
      "limit": "15 KB",
      "ignore": [
        "zod"
      ],
      "gzip": true
    }
  ]
}

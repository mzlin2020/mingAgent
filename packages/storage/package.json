{
  "name": "@xm/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite 事件存储与文件 blob 存储：EventStore / BlobStore 端口的落地实现。不依赖 electron",
  "main": "./dist/index.js",

  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@xm/contracts": "workspace:*",
    "@xm/kernel": "workspace:*",
    "better-sqlite3": "13.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}

{
  "name": "@xm/providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ModelProvider 的各家实现。只用 Web 平台 API（fetch / AbortController / TextDecoder），不依赖 node:* 也不依赖 electron",
